prefix=/usr/local
exec_prefix=${prefix}
libdir=/usr/local/lib
includedir=/usr/local/include

Name: absl_hashtable_profiler
Description: Abseil hashtable_profiler library
URL: https://abseil.io/
Version: head
Requires: absl_profile_builder = head, absl_config = head, absl_core_headers = head, absl_strings = head, absl_span = head, absl_hashtablez_sampler = head
Libs: -L${libdir}  -labsl_hashtable_profiler 
Cflags: -I${includedir} -DNOMINMAX
